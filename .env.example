# Copy to .env.local and fill in. Never commit real values.

# Investor login (ADR-0006). Required for `next build` / `next start`; `next dev` falls back to the development account in README when all three are empty.
INVESTOR_USERNAME=
# Output of `npm run auth:hash-password`; the plain password is never stored.
INVESTOR_PASSWORD_HASH=
# At least 32 random characters, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Firebase Admin SDK service account for project database-inzta (the ERP dashboard database), created by the owner. Server only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the PEM on one line with literal 
 line breaks.
FIREBASE_PRIVATE_KEY=

# Local only: when set (127.0.0.1:8080), the portal reads the Firestore emulator instead of the real project.
FIRESTORE_EMULATOR_HOST=
