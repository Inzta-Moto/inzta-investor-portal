# Copy to .env.local and fill in. Never commit real values.

# Data source: "mock" (default) until the Firebase integration (F-006) is unblocked.
INVESTOR_DATA_SOURCE=mock

# Demo login (ADR-0004). Required for `next build` / `next start`; `next dev` falls back to the documented demo account when all three are empty.
DEMO_INVESTOR_USERNAME=
DEMO_INVESTOR_PASSWORD=
# At least 32 random characters, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Firebase web app config for the project shared with the internal Inzta dashboard (used from F-006).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
